{
  "name": "short-video-director",
  "version": "1.0.0",
  "private": true,
  "description": "350 Years of Rule, Lost in a Week \u2014 Remotion + React Three Fiber vertical explainer",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts Main out/main.mp4 --crf=18",
    "typecheck": "tsc --noEmit",
    "render:cloud": "remotion render src/index.ts Main out/main.mp4 --crf=18 --concurrency=3 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --gl=swangle",
    "render:subs": "remotion render src/index.ts Main out/main_subs.mp4 --crf=18 --props={\\\"showSubtitles\\\":true}",
    "stills:cloud": "node tools/stills.mjs",
    "setup-check:cloud": "remotion render src/index.ts SetupCheck out/setup-check.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --gl=swangle",
    "sfx": "python3 tools/sfx.py",
    "render:kahfi": "remotion render src/index.ts AshabulKahfi1 out/ashabul-kahfi-1.mp4 --crf=18 --concurrency=3 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --gl=swangle",
    "stills:kahfi": "REMOTION_COMP=AshabulKahfi1 node tools/stills.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.544",
    "@remotion/media-utils": "4.0.544",
    "@remotion/three": "4.0.544",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
